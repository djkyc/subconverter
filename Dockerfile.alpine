# 第一阶段：构建环境（Alpine 作为编译镜像）
FROM alpine:latest AS builder

LABEL maintainer="your-email@example.com"

# 安装编译工具链和依赖库
RUN apk add --no-cache \
    git \
    cmake \
    g++ \
    make \
    openssl-dev \
    pcre-dev \
    zlib-dev \
    linux-headers \
    ca-certificates

WORKDIR /app

# 克隆你想要打包的项目
RUN git clone https://github.com/asdlokj1qpi233/subconverter.git .

# 编译项目（静态链接，避免运行时缺少 .so 文件）
RUN cd subconverter \
    && cmake -DCMAKE_EXE_LINKER_FLAGS="-static" . \
    && make -j$(nproc)

# 第二阶段：运行环境（最小的 Alpine 镜像）
FROM alpine:latest

# 安装必要的运行时动态库（如果上面使用 -static 编译，可以省略下面这行）
RUN apk add --no-cache \
    ca-certificates \
    libssl3 \
    libpcrecpp \
    zlib

# 从构建阶段复制编译好的二进制文件
COPY --from=builder /app/subconverter/subconverter /subconverter

WORKDIR /subconverter

# 暴露默认端口（subconverter 默认是 25500）
EXPOSE 25500

ENTRYPOINT ["./subconverter"]
