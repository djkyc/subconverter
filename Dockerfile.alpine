# ----------------------------------------------------------
# 第一阶段：构建环境（Alpine）
# ----------------------------------------------------------
FROM alpine:latest AS builder

# 安装 Alpine 下的编译依赖
RUN apk add --no-cache \
    git \
    cmake \
    g++ \
    make \
    pkgconfig \
    openssl-dev \
    pcre-dev \
    zlib-dev \
    curl-dev \
    yaml-cpp-dev \
    rapidjson-dev \
    linux-headers

# 正确安装 toml11（通过 CMake 编译安装以生成 CMake 配置文件）
RUN git clone --depth 1 https://github.com/ToruNiina/toml11.git /tmp/toml11 && \
    cd /tmp/toml11 && \
    mkdir build && cd build && \
    cmake .. -DCMAKE_INSTALL_PREFIX=/usr/local && \
    make install && \
    rm -rf /tmp/toml11

WORKDIR /app

# 克隆项目源码
RUN git clone https://github.com/asdlokj1qpi233/subconverter.git .

# 编译（动态链接）
RUN cmake . && make -j$(nproc)

# ----------------------------------------------------------
# 第二阶段：运行环境（Alpine 最小镜像）
# ----------------------------------------------------------
FROM alpine:latest

# 安装运行时动态库
RUN apk add --no-cache \
    ca-certificates \
    openssl \
    pcre \
    zlib \
    libcurl \
    yaml-cpp \
    tzdata

# 创建并切换到工作目录
WORKDIR /subconverter

# 1. 复制编译好的二进制文件到当前目录
COPY --from=builder /app/subconverter ./subconverter

# 2. 关键：将运行必需的配置目录和文件一同复制进来！
COPY --from=builder /app/base ./base
COPY --from=builder /app/config ./config
COPY --from=builder /app/generate.ini ./generate.ini

EXPOSE 25500

ENTRYPOINT ["./subconverter"]
